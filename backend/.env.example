# Lokum backend env — copy to .env and fill in real values.

# Database (Neon Postgres or any pg 14+)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Server
PORT=9120
PUBLIC_ORIGIN=https://flats.chmyl.com
COOKIE_SECURE=1
CORS_ORIGIN=https://flats.chmyl.com
NODE_ENV=production

# Facebook scraper (Python bridge) — only needed for source_id=7
FACEBOOK_COOKIE_KEY=replace-with-base64-key

# --- OpenRouter (Agent E) ---
# AI backend for translate.js + totalprice.js. The seam lives in
# services/ai-client.js; OPENROUTER_API_KEY is the only hard requirement.
# OPENROUTER_MODEL defaults to deepseek/deepseek-chat (the non-reasoning
# variant; deepseek-v4-flash-latest is not a valid OpenRouter model id).
# Override via env if/when OpenRouter exposes a newer non-reasoning id.
#
# Optional tuning:
#   AI_TIMEOUT_MS    — per-call hard timeout in ms (default 15000)
#   AI_MAX_TOKENS    — default max_tokens for completions (default 1024)
#   AI_TEMPERATURE   — default temperature for completions (default 0.2)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- Google Maps Places API (Agent F — POI fetching) ---
# Drives the "nearby POIs" chips (stores / gyms / malls / parks / restaurants)
# shown on each listing card + detail page. Optional: when unset (or when the
# quota is exceeded) the backend falls back to the OpenStreetMap Overpass API,
# which is free but slightly less accurate on names + addresses.
# Get a key at https://console.cloud.google.com/google/maps-apis — enable the
# "Places API (New)" or "Places API" under Maps JavaScript API / Places.
# Free tier: ~$200 monthly credit, plenty for a single-user rental aggregator.
GOOGLE_MAPS_API_KEY=

# --- Always-on fetcher (Task I — H4 design) ---
# The always-on watcher probes page 1 of each source's search feed on a
# sub-minute cadence, computes a hash of returned listing IDs, and on hash
# change enqueues new listings via runner.js#enqueueNewListing. Lives in a
# SEPARATE Chromium instance + per-platform persistent BrowserContexts (in
# backend/.playwright-state/<slug>.json) so anti-bot systems see a stable
# returning visitor. Coexists with the existing full-cron (every ~30 min)
# via an in-memory mutex — the watcher pauses while runFetchCycle runs.
#
# LOKUM_ALWAYS_ON defaults to 1; set to 0 to disable (e.g. on a dev machine
# where you don't want background scraping). LOKUM_ONESHOT=1 also disables
# (CLI mode — no long-lived process).
LOKUM_ALWAYS_ON=1

# Per-source poll intervals (ms). H4 §7.3 defaults:
ALWAYSON_OLX_INTERVAL=75000
ALWAYSON_OTODOM_INTERVAL=150000
ALWAYSON_GRATKA_INTERVAL=90000
ALWAYSON_MORIZON_INTERVAL=90000
ALWAYSON_ADRESOWO_INTERVAL=180000
ALWAYSON_FACEBOOK_INTERVAL=180000

# Circuit breaker: pause a source for this long after 3 consecutive errors.
ALWAYSON_PAUSE_MS=300000

# Max number of last-seen IDs kept per (source, city) watermark ring.
ALWAYSON_WATERMARK_CAP=500

# Optional: headful Chrome via Xvfb (more stealth against Datadome, ~50MB extra RAM).
ALWAYSON_HEADFUL=0

# Optional: residential proxy for Otodom only, set if sustained block-rate > 5%.
# Format: http://user:pass@proxy.brightdata.com:22225
# Other sources accept PROXY_<SLUG>_URL (e.g. PROXY_GRATKA_URL) — currently unused.
PROXY_OTODOM_URL=

# --- Allegro.pl nieruchomości (Task D-allegro-14, source_id=21) ---
# Allegro is the most aggressive anti-bot target in Poland (enterprise-grade
# bot detection) — HTML scraping is not viable. The scraper therefore uses
# Allegro's OFFICIAL REST API at developer.allegro.pl:
#
#   1. Register an application at https://developer.allegro.pl/apps
#      (free; needs an Allegro.pl account + email confirmation).
#   2. Copy the CLIENT_ID + CLIENT_SECRET from the app dashboard here.
#   3. The scraper does an OAuth2 client_credentials POST to
#      https://allegro.pl/auth/oauth/token?grant_type=client_credentials
#      with HTTP Basic auth, gets a Bearer token (TTL 12h, cached 11h),
#      then calls GET https://api.allegro.pl/offers/listing with
#      category.id=112745 (Mieszkania do wynajęcia) +
#      location.city.id=110009 (Warszawa).
#
# !!! CRITICAL — VERIFICATION REQUIREMENT !!!
# As of 2025-03-15, Allegro requires the application to be "verified"
# before /offers/listing calls succeed. Unverified apps get HTTP 403
# VerificationRequired. As of 2025-09-22 Allegro SUSPENDED verification
# for new apps for business reasons (see
# https://github.com/allegro/allegro-api/issues/12257). The scraper
# handles the 403 gracefully (clear actionable warning + returns []),
# so when Allegro reopens verification the scraper will start returning
# data with no code changes.
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
# Optional: override the default 30-page walk (60 offers/page × 30 = 1800/city).
ALLEGRO_MAX_PAGES=30

